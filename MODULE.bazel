"""Warlords II remake: the C++ port, built with Bazel (cpp/)."""

module(name = "warlords2")

# Apple's toolchain first: SDL2 compiles Objective-C on macOS.
bazel_dep(name = "apple_support", version = "2.5.2", repo_name = "build_bazel_apple_support")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "sdl2", version = "2.32.0.bcr.beta.7")
bazel_dep(name = "vorbis", version = "1.3.7.bcr.1")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", dev_dependency = True)

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":copts.bzl", "W2_COPTS")

package(default_visibility = ["//visibility:private"])

# Layer 1: Low-level utilities, RNG, and binary readers.
cc_library(
    name = "util",
    copts = W2_COPTS,
    srcs = glob(["src/util/*.cpp"]) + [
        "src/warlords/rng.cpp",
    ],
    hdrs = glob(["src/util/*.hpp"]) + [
        "src/warlords/bytes.hpp",
        "src/warlords/rng.hpp",
    ],
    includes = ["src"],
    deps = [
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/base:no_destructor",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/flags:usage",
        "@abseil-cpp//absl/log:absl_check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/synchronization",
        "@abseil-cpp//absl/time",
        "@abseil-cpp//absl/types:span",
    ],
    visibility = ["//cpp:__subpackages__"],
)

# Layer 2: Domain model entities, strong IDs, and encapsulated state subsystems.
cc_library(
    name = "model",
    copts = W2_COPTS,
    srcs = glob(["src/warlords/model/*.cpp"]),
    hdrs = glob(["src/warlords/model/*.hpp"]) + ["src/warlords/types.hpp"],
    includes = ["src"],
    deps = [
        ":util",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/log:absl_check",
        "@abseil-cpp//absl/types:span",
    ],
    visibility = ["//cpp:__subpackages__"],
)

# Layer 3: Original Warlords II binary/text file formats (.SCN, .PCK, .XMI, ...).
cc_library(
    name = "formats",
    copts = W2_COPTS,
    srcs = [
        "src/warlords/aicard.cpp",
        "src/warlords/ailfm.cpp",
        "src/warlords/armytype.cpp",
        "src/warlords/cues.cpp",
        "src/warlords/opl.cpp",
        "src/warlords/pal.cpp",
        "src/warlords/pck.cpp",
        "src/warlords/preview.cpp",
        "src/warlords/scenario_source.cpp",
        "src/warlords/scenarios.cpp",
        "src/warlords/scn.cpp",
        "src/warlords/uidata.cpp",
        "src/warlords/xmi.cpp",
    ],
    hdrs = [
        "src/warlords/aicard.hpp",
        "src/warlords/ailfm.hpp",
        "src/warlords/armytype.hpp",
        "src/warlords/cues.hpp",
        "src/warlords/opl.hpp",
        "src/warlords/pal.hpp",
        "src/warlords/pck.hpp",
        "src/warlords/preview.hpp",
        "src/warlords/scenario_source.hpp",
        "src/warlords/scenarios.hpp",
        "src/warlords/scn.hpp",
        "src/warlords/scn_format.hpp",
        "src/warlords/uidata.hpp",
        "src/warlords/xmi.hpp",
    ],
    includes = ["src"],
    deps = [
        ":model",
        ":util",
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/base:no_destructor",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/synchronization",
        "@abseil-cpp//absl/types:span",
    ],
    visibility = ["//cpp:__subpackages__"],
)

# Layer 4: Core game rules, movement, combat, diplomacy, and AI controllers.
cc_library(
    name = "rules",
    copts = W2_COPTS,
    srcs = [
        "src/warlords/ai.cpp",
        "src/warlords/combat.cpp",
        "src/warlords/diplomacy.cpp",
        "src/warlords/game.cpp",
        "src/warlords/hero.cpp",
        "src/warlords/history.cpp",
        "src/warlords/move.cpp",
        "src/warlords/quest.cpp",
        "src/warlords/report.cpp",
        "src/warlords/rules.cpp",
        "src/warlords/site.cpp",
        "src/warlords/slots.cpp",
        "src/warlords/travel.cpp",
    ] + glob(["src/warlords/ai/*.cpp"]),
    hdrs = [
        "src/warlords/ai.hpp",
        "src/warlords/combat.hpp",
        "src/warlords/diplomacy.hpp",
        "src/warlords/game.hpp",
        "src/warlords/hero.hpp",
        "src/warlords/history.hpp",
        "src/warlords/move.hpp",
        "src/warlords/quest.hpp",
        "src/warlords/report.hpp",
        "src/warlords/rules.hpp",
        "src/warlords/site.hpp",
        "src/warlords/slots.hpp",
        "src/warlords/travel.hpp",
    ] + glob(["src/warlords/ai/*.hpp"]),
    includes = ["src"],
    deps = [
        ":formats",
        ":model",
        ":util",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@nlohmann_json//:json",
    ],
    visibility = ["//cpp:__subpackages__"],
)

# Layer 5: World generation (classic RANDOM.DAT generator, modern scengen, map evaluator).
cc_library(
    name = "worldgen",
    copts = W2_COPTS,
    srcs = [
        "src/warlords/mapeval.cpp",
        "src/warlords/randommap.cpp",
        "src/warlords/scengen.cpp",
    ] + glob(["src/warlords/worldgen/*.cpp"]),
    hdrs = [
        "src/warlords/mapeval.hpp",
        "src/warlords/randommap.hpp",
        "src/warlords/scengen.hpp",
    ] + glob(["src/warlords/worldgen/*.hpp"]),
    includes = ["src"],
    deps = [
        ":formats",
        ":model",
        ":rules",
        ":util",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@nlohmann_json//:json",
    ],
    visibility = ["//cpp:__subpackages__"],
)

# Layer 6: Persistence (save game serialization).
cc_library(
    name = "persistence",
    copts = W2_COPTS,
    srcs = [
        "src/warlords/save.cpp",
    ],
    hdrs = [
        "src/warlords/save.hpp",
    ],
    includes = ["src"],
    deps = [
        ":formats",
        ":model",
        ":rules",
        ":util",
        ":worldgen",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@nlohmann_json//:json",
    ],
    visibility = ["//cpp:__subpackages__"],
)

# Umbrella target for headless tools and tests.
cc_library(
    name = "w2core",
    copts = W2_COPTS,
    includes = ["src"],
    linkopts = ["-lpthread"],
    deps = [
        ":formats",
        ":model",
        ":persistence",
        ":rules",
        ":util",
        ":worldgen",
    ],
    visibility = ["//cpp:__subpackages__"],
)

# Layer 6b: User preferences store persisted as JSON.
cc_library(
    name = "config",
    copts = W2_COPTS,
    srcs = ["src/config/preferences_store.cpp"],
    hdrs = ["src/config/preferences_store.hpp"],
    includes = ["src"],
    deps = [
        ":util",
        "@abseil-cpp//absl/status",
        "@nlohmann_json//:json",
        "@sdl2",
        "@sdl2//:sdl2_headers_flat",
    ],
    visibility = ["//cpp:__subpackages__"],
)

# Layer 7: Platform RAII abstractions over SDL2, OpenGL, Vorbis audio, and AI turn monitor.
cc_library(
    name = "platform",
    copts = W2_COPTS,
    srcs = glob(["src/platform/*.cpp"]),
    hdrs = glob(["src/platform/*.hpp"]),
    defines = ["W2_VORBIS=1"],
    includes = ["src"],
    deps = [
        ":formats",
        ":model",
        ":util",
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/base:no_destructor",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/log:absl_check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/synchronization",
        "@sdl2",
        "@sdl2//:sdl2_headers_flat",
        "@vorbis//:vorbisfile",
    ],
    visibility = ["//cpp:__subpackages__"],
)

# Layer 8: SDL2 UI front-end and modal dialogs.
cc_library(
    name = "ui_front",
    copts = W2_COPTS,
    srcs = glob([
        "src/ui/*.cpp",
        "src/front/*.cpp",
    ]),
    hdrs = glob([
        "src/ui/*.hpp",
        "src/front/*.hpp",
    ]),
    defines = ["W2_VORBIS=1"],
    includes = ["src"],
    deps = [
        ":config",
        ":platform",
        ":w2core",
        "@abseil-cpp//absl/base:no_destructor",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings:str_format",
        "@nlohmann_json//:json",
        "@sdl2",
        "@sdl2//:sdl2_headers_flat",
    ],
    visibility = ["//cpp:__subpackages__"],
)

# The game: the slim entry point over :ui_front.
cc_binary(
    name = "warlords2",
    copts = W2_COPTS,
    srcs = ["src/main.cpp"],
    defines = ["W2_VORBIS=1"],
    includes = ["src"],
    deps = [
        ":platform",
        ":ui_front",
        ":w2core",
        "@abseil-cpp//absl/flags:flag",
        "@sdl2",
        "@sdl2//:sdl2_headers_flat",
    ],
)

# bazel run //cpp:play: the game, run in the repository root.
sh_binary(
    name = "play",
    srcs = ["play.sh"],
    args = ["$(rootpath :warlords2)"],
    data = [":warlords2"],
)


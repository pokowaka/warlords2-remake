# The original game's files, which the game, the tools and the tests read at
# run time (from "original/" under their working directory).
filegroup(
    name = "original_data",
    srcs = glob(
        [
            "original/**",
            "reference/original/**",
        ],
        exclude = [
            # the setup screen rewrites it whenever a game starts; nothing
            # headless reads it
            "original/DATA/OPTIONS.DAT",
            "reference/original/DATA/OPTIONS.DAT",
        ],
    ),
    visibility = ["//visibility:public"],
)

alias(
    name = "warlords2",
    actual = "//cpp:warlords2",
    visibility = ["//visibility:public"],
)

alias(
    name = "scengen",
    actual = "//cpp:w2scengen",
    visibility = ["//visibility:public"],
)

alias(
    name = "web",
    actual = "//web:serve",
    visibility = ["//visibility:public"],
)

alias(
    name = "web_build",
    actual = "//web:build",
    visibility = ["//visibility:public"],
)
